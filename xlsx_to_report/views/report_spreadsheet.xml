<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_spreadsheet_form" model="ir.ui.view">
        <field name="name">report.spreadsheet.form</field>
        <field name="model">report.spreadsheet</field>
        <field name="arch" type="xml">
            <form string="Report Spreadsheet">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="report_spreadsheet_list" model="ir.ui.view">
        <field name="name">report.spreadsheet.list</field>
        <field name="model">report.spreadsheet</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="spreadsheet_id"/>
                <field name="report_spreadsheet_binary_data" widget="binary" filename="file_name" optional="show" invisible="not report_spreadsheet_binary_data"/>
                <field name="model_id"/>
                <field name="use_company_layout" widget="boolean_toggle"/>
                <button string="Edit" class="float-end" name="action_edit_template" type="object" icon="fa-pencil"/>
            </list>
        </field>
    </record>

    <record id="action_report_spreadsheet" model="ir.actions.act_window">
        <field name="name">Report Spreadsheet</field>
        <field name="res_model">report.spreadsheet</field>
        <field name="view_mode">list</field>
    </record>
</odoo>